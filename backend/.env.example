# Server Configuration
PORT=8080
APP_ENV=development

# MySQL Database (Local or Cloud e.g. TiDB Cloud / Aiven)
DB_USER=splito_app
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=splito_db
DB_TLS=false

# Optional: Full Cloud DSN (Overrides individual DB_* params if set)
# DATABASE_URL=user:pass@tcp(host:4000)/dbname?tls=true

# Redis (Optional)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Email / OTP Delivery (Gmail App Password or SMTP Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
